# Copia este archivo como .env y ajusta los valores
DATABASE_URL=postgresql+psycopg2://cms:cms@localhost:5432/cms

# Si USE_MOCKS=true, el Builder y la API de métricas se simulan localmente.
# Ponlo en false cuando esos módulos ya estén corriendo.
USE_MOCKS=true
BUILDER_URL=http://localhost:8001
METRICS_URL=http://localhost:8002/graphql
HTTP_TIMEOUT_SECONDS=60
